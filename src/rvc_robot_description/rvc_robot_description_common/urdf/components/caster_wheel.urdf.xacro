<?xml version="1.0"?>
<robot name="caster_wheel" xmlns:xacro="http://wiki.ros.org/xacro">

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <xacro:macro
    name="caster_wheel"
    params="prefix:=caster_wheel *origin parent:=base_link"
  >
    <joint name="${prefix}_base_mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_base_link"/>
    </joint>

    <link name="${prefix}_base_link">
      <visual>
        <geometry>
          <sphere radius="0.006"/>
        </geometry>
        <material name="white"/>
      </visual>
    </link>

  </xacro:macro>
</robot>
